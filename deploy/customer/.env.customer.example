# =============================================================================
# Lurus Tally — on-premise deployment configuration
# Copy this file to `.env` next to docker-compose.customer.yml and fill in the
# blank values. Never commit the resulting `.env` file — it will hold secrets.
# =============================================================================

# ── Image source (Path A: delivered image tarball) ──────────────────────────
# Leave both blank to build from source (Path B — needs Docker/network access
# to pull golang/bun/node base images and Go/npm module registries at build
# time; see INSTALL.md "Path B"). If your vendor handed you an image tarball
# instead, `docker load -i <tarball>` and paste the two tags it prints
# ("Loaded image: ...") here verbatim, then start with `--pull never`.
TALLY_BACKEND_IMAGE=
TALLY_WEB_IMAGE=

# ── Database (Postgres container credentials) ───────────────────────────────
POSTGRES_USER=tally
# REQUIRED. Generate with: openssl rand -hex 24
# This value is interpolated verbatim (unquoted) into DATABASE_DSN as part of
# a postgres:// URL for the backend container — do not also set DATABASE_DSN
# here. Avoid characters that break a URL or the compose env-file parser:
# `@ / # % ? :` must not appear, and a literal `$` must be written as `$$`
# (compose treats a single `$` as the start of a variable reference).
# `openssl rand -hex` output is always URL-safe and satisfies this.
POSTGRES_PASSWORD=
POSTGRES_DB=lurus

# ── Backend (Go service) ─────────────────────────────────────────────────────
# Full list of backend variables: see ../../.env.example (this file only lists
# the ones you typically must change for an on-premise install).

# Run embedded SQL migrations automatically on container start. Leave true
# unless your DBA wants to review migrations before applying them manually
# (see INSTALL.md "升级" section for the manual path).
MIGRATE_ON_BOOT=true

PORT=18200
LOG_LEVEL=info
GIN_MODE=release

# 仅排障用，生产禁开；开启后 /api/v1 无鉴权。
# Backend-only escape hatch: when true, the backend skips JWT validation and
# trusts X-IDP-Subject / X-Tenant-ID headers instead of a real OIDC token.
# This does NOT make the web UI's login button work — see INSTALL.md "登录"
# section: the web image is always built with NODE_ENV=production, which
# hard-blocks its own dev auth path regardless of this variable. TALLY_DEV_MODE
# only unblocks direct backend API calls (e.g. curl with trusted headers) for
# a first smoke test. Never set true in a deployment reachable by real users.
#
# First-boot decision required: with this false (the default below) AND
# OIDC_ISSUER blank, the backend refuses to start at all (crash-loops under
# `restart: unless-stopped`) — see INSTALL.md "Common first-boot issues".
# Either fill in OIDC_ISSUER + OIDC_AUDIENCE below, or set this to true for a
# throwaway smoke test.
TALLY_DEV_MODE=false

# Vendor-neutral OIDC issuer for the backend to validate JWTs against.
# Must match the issuer your identity provider actually issues tokens from.
# REQUIRED for the web UI login button to work end-to-end — see INSTALL.md
# "登录" section for the full 3-variable checklist (this + OIDC_AUDIENCE here,
# OIDC_CLIENT_ID below) and a minimal walkthrough against a generic OIDC
# provider (e.g. Keycloak or Casdoor).
OIDC_ISSUER=
OIDC_AUDIENCE=

# Platform / AI / memory integrations are optional. Leave blank to run Tally
# standalone — every feature gated on these degrades gracefully (see
# ../../.env.example for the full explanation of each var's degrade mode).
# 留空 = 不接 platform(独立运行)。K8s 部署时由 configmap.yaml 提供。
PLATFORM_BASE_URL=
# 通知服务地址,留空则只走 NATS 事件通道。
PLATFORM_NOTIFY_URL=
PLATFORM_INTERNAL_KEY=
# ⚠️ NEWAPI_BASE_URL 必须以版本段结尾(如 .../v1)—— 客户端直接拼 "/chat/completions"。
# 留空 = AI 助手关闭(代码内不再有默认地址);填错同样是静默 404。
# 启用 AI 需同时填 NEWAPI_BASE_URL、NEWAPI_API_KEY、DEFAULT_AI_MODEL 三项,缺任一项 AI 整体关闭(日志仅一条 Warn)。
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
# 必填(启用 AI 时):默认模型名,须是网关已开通的模型;留空则 AI 关闭。
DEFAULT_AI_MODEL=
# 可选:对话 / 口述开单抽取分别指定模型,留空沿用 DEFAULT_AI_MODEL。
AI_MODEL_CHAT=
AI_MODEL_EXTRACT=
# 可选:模型单价(人民币),用于成本指标;留空则成本指标恒为 0。
LLM_MODEL_PRICES_CNY=
# ⚠️ MEMORUS_BASE_URL 必须带 /api/v1 后缀 —— 服务端把接口挂在该前缀下,漏了会**每次调用都 404**,
# 而且是静默的(记忆召回只是查不到东西,不会报错)。同机另一套 compose 时形如:
#   MEMORUS_BASE_URL=http://host.docker.internal:8880/api/v1
MEMORUS_BASE_URL=
# 与 memorus 那边 .env 里设的 MEMORUS_API_KEY 填同一个值(它是单一共享密钥,以 X-API-Key 头发送)。
MEMORUS_API_KEY=
SHOPIFY_WEBHOOK_SECRET=

# ── Web (Next.js frontend) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Same OIDC provider as the backend (client registered for the web app).
# REQUIRED for login — see INSTALL.md "登录" section. Leaving this blank does
# not disable login; the login page still renders, but clicking the sign-in
# button fails (NextAuth error) with no IdP configured.
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# In-network address of the backend container — do not change unless you
# renamed the `backend` service in docker-compose.customer.yml.
BACKEND_URL=http://backend:18200

# Public URL your users/browsers will use to reach the web UI. Must match
# TALLY_WEB_PUBLIC_URL below.
NEXTAUTH_URL=http://localhost:3000

# ── Host port mapping (docker-compose.customer.yml reads these) ────────────
# TALLY_WEB_PORT / TALLY_WEB_PUBLIC_URL / NEXTAUTH_URL are linked — if you
# remap the web port away from the 3000 default, update all three together
# (NEXTAUTH_URL and TALLY_WEB_PUBLIC_URL must both carry the new host port,
# and your OIDC provider's registered redirect URI must match too) or OIDC
# callbacks will land on the wrong port and login will fail.
# To bind loopback-only (recommended when TALLY_DEV_MODE=true, since that
# mode disables API auth entirely): use e.g. `127.0.0.1:18200` here instead
# of a bare port number — the compose `ports:` template accepts either form.
TALLY_BACKEND_PORT=18200
TALLY_WEB_PORT=3000
TALLY_WEB_PUBLIC_URL=http://localhost:3000
