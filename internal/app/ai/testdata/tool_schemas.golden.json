    ],
    "type": "object"
  },
  "recall_customer_facts_as_of": {
    "properties": {
      "as_of": {
        "description": "The moment the user asks about: YYYY-MM-DD, YYYY-MM, or just the month (\"03\") when the user names no year — the most recent such month is used. A period means its end. Convert relative times (上个月, 上周三, 前天) to a date from today's date; never pass the words themselves.",
        "type": "string"
      },
      "customer": {
        "description": "Customer as the user named them, including address forms like 老张/王老板/李总",
        "type": "string"
      },
      "topic": {
        "description": "What the user asks about, in their words (e.g. 付款方式, 送货地址); optional",
        "type": "string"
      }
    },
    "required": [
      "customer",
      "as_of"
    ],
    "type": "object"
  },
  "recent_sales_top": {
    "properties": {
      "days": {
        "description": "Lookback days (default 7)",
        "type": "integer"
      },
      "limit": {
        "description": "Number of results (default 10)",
        "type": "integer"
      },
      "metric": {
        "enum": [
          "revenue",
          "margin",
          "qty"
        ],
        "type": "string"
      }
    },
    "required": [
      "metric"
    ],
    "type": "object"
  },
  "remember_customer_fact": {
    "properties": {
      "attribute": {
        "description": "Which attribute of the customer the statement is about",
        "enum": [
          "payment_method",
          "settlement",
          "delivery_address",
          "delivery_time",
          "delivery_method",
          "packaging",
          "contact",
          "invoice",
          "price_terms",
          "allergy",
          "taste",
          "regular_items",
          "other"
        ],
        "type": "string"
      },
